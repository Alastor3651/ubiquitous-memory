# --- Database (Supabase Postgres connection string) ---
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, "Transaction" pooling mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection, used only for running migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# --- NextAuth ---
# The full URL of your app. In local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# --- Supabase Storage (used for document uploads) ---
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Project Settings -> API -> service_role key (SECRET - server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Name of the Storage bucket you create for application documents
SUPABASE_STORAGE_BUCKET="documents"
